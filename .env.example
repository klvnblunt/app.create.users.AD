# Variáveis de ambiente (cadastre na aba Environment do Dokploy)
SECRET_KEY=gere-um-texto-longo-e-aleatorio
# Usuários da tela de login: usuario:senha;outro:senha  (evite ";" na senha)
WEB_USERS=jonas:troque-esta-senha
LDAP_BIND_USER=svc-adweb@ad.gavom.local
LDAP_BIND_PASSWORD=senha-da-conta-de-servico
DEFAULT_PASSWORD=Mudar@123
# 1 = valida o certificado com o ca.pem (recomendado). 0 = só para teste.
LDAP_VERIFY=1
# 1 = cookie só em HTTPS. Use 0 apenas se testar por http.
COOKIE_SECURE=1
